[Unit]
Description=Bike computer (power meter dashboard)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
User=henriks
WorkingDirectory=/home/henriks/dev/Claude/Bike computer
ExecStart="/home/henriks/dev/Claude/Bike computer/.venv/bin/python" bikecomputer.py --source ant
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
