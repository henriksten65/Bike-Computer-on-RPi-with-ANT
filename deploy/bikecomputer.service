# Template: deploy/install.sh fills in @USER@ and @DIR@ and installs it as
# /etc/systemd/system/bikecomputer.service.
[Unit]
Description=Bike computer (power meter dashboard)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart="@DIR@/.venv/bin/python" bikecomputer.py --source ant
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
